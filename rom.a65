;
; ROM demo with a 6551 ACIA mapped to $8800
;

        .setcpu "65C02"         ; This makes more instructions available.

;
; Macro definitions for memory locations and bit masks.
;


;
; 6522 Versatile Interface Adapter (VIA)
; https://6502.org/documents/datasheets/mos/mos_6522_preliminary_nov_1977.pdf
;
VIA_BASE    = $8000             ; Four register select pins are memory mapped from here, giving sixteen possible addresses.
VIA_ORB     = VIA_BASE          ; Output Register B (ORB)
VIA_ORA     = VIA_BASE + 1      ; Output Register A (ORA)
VIA_DDRB    = VIA_BASE + 2      ; Data Direction Register B (DDRB)
VIA_DDRA    = VIA_BASE + 3      ; Data Direction Register A (DDRA)
VIA_T1C_L   = VIA_BASE + 4      ; Timer 1 Count LOW (T1L-L). Low-order byte of initial 16-bit counter value written here.
VIA_T1C_H   = VIA_BASE + 5      ; Timer 1 Count HIGH (T1L-H). High-order byte of initial 16-bit counter. Writing starts timer.
VIA_ACR     = VIA_BASE + $0B    ; Auxiliary Control Register (ACR)
VIA_IFR     = VIA_BASE + $0D    ; Interrupt Flag Register (IFR). Read or clear interrupt flags.
VIA_IER     = VIA_BASE + $0E    ; Interrupt Enable Register (IER). Mask to enable / disable different interrupt triggers.

VIA_T1_PERIOD = 9998            ; 1 mS - 2 uS on a 1MHz system. Interval time is (period + 1) / clock_freq.

;
; 6551 Asynchronous Communications Interface Adapter (ACIA) hardware.
; https://6502.org/documents/datasheets/mos/mos_6551_acia.pdf
;
ACIA_BASE   = $8800             ; Two register select pins are memory mapped from here, giving four possible addresses.
ACIA_DATA   = ACIA_BASE         ; RS1 = 0, RS0 = 0
ACIA_STATUS = ACIA_BASE + 1     ; RS1 = 0, RS0 = 1
ACIA_CMD    = ACIA_BASE + 2     ; RS1 = 1, RS0 = 0
ACIA_CTRL   = ACIA_BASE + 3     ; RS1 = 1, RS0 = 1

ACIA_TDRE   = $10               ; Transmit Data Register Empty (TDRE) bit mask
ACIA_RDRF   = $80               ; Receive Data Register Full (RDRF) bit mask


;
; Zero page locations.
;
JIFFIES= $0000                  ; 4-byte elapsed 1/100 second counter updated by free running 6522 VIA Timer 1 interrupt.
PUTS_PTR = $0004                ; 2-byte location of the null-terminated string to be transmitted by the puts subroutine.
ACIA_FIFO_HEAD = $0006          ; 1-byte index of next buffer location to read. Head of ACIA FIFO.
ACIA_FIFO_TAIL = $0007          ; 1-byte index of next buffer location to write. Tail of ACIA FIFO.
CMD_BUFFER_PTR = $0008          ; Index pointer of First-In Last-Out (FILO) command buffer.

;
; Input ring buffer.
;
ACIA_FIFO = $200                ; Raw bytes received from the 6551 ACIA (up to 255 bytes.)

;
; Command buffer.
;
CMD_BUFFER = $300               ; Bytes processed from input buffer that form a command string.
CMD_MAX_LEN = $10               ; The longest command accepted (not including null terminator.

;
; Start of 16k ROM
;
        .segment "SYSTEM"
        .org $C000


;
; Code to be executed at power-up or hardware reset. Responsible for getting the processor to a usable state.
;
reset:
        sei                     ; Don't want to be disturbed while all this is set up.
        cld                     ; Ensure binary, not binary coded decimal (BCD).
        ldx     #$FF            ; $FF represents the top of the stack.
        txs                     ; Transfer the value to the stack pointer.

; Ensure the 32-bit jiffies (1/100th of a second) counter is reset to zero.
        lda #$00
        sta JIFFIES
        sta JIFFIES + 1
        sta JIFFIES + 2
        sta JIFFIES + 3

; The 6522 VIA is initialized as a timer interrupting at regular intervals to serve as a real-time clock interrupt.
        lda #$40                ; Timer 1 operating in free running mode with no PB7 toggle.
        sta VIA_ACR             ; Save the configuration to the Auxiliary Control Register (ACR).
        lda #<VIA_T1_PERIOD     ; Store the lower byte of the T1 time period.
        sta VIA_T1C_L           ; Actual transfer of this value happens when the high-order byte is written.
        lda #>VIA_T1_PERIOD     ; Store the upper byte of the T1 time period.
        sta VIA_T1C_H           ; Writing this value also starts the timer.
        lda #$C0                ; Bit 7 is the enable/disable flag. Bit 6 is for Timer 1.
        sta VIA_IER             ; Save the configuration to the Interrupt Enable Register (IER).

; The 6551 ACIA is initialized at 9600 bps, 8 data bits, no parity¿one stop bit, to serve as a console terminal.
        lda #$00                ; Head and tail are initially the same to indicate the input buffer is empty.
        sta ACIA_FIFO_HEAD
        sta ACIA_FIFO_TAIL

        lda #$00
        sta ACIA_STATUS         ; Software reset of 6551 by writing to device's status register.
        lda #$09                ; Configure no parity, no echo, RX interrupt, but no TX interrupt.
        sta ACIA_CMD
        lda #$1E                ; Configure 9600 baud, 8 data bits, 1 stop bit.
        sta ACIA_CTRL

; The command buffer pointer is reset to the beginning.
        lda #$00
        sta CMD_BUFFER_PTR

; Ready to accept user input.
        cli                     ; Allow interrupts again.
        ldx #<ready_msg         ; Output a message to tell the user the system is ready for input.
        ldy #>ready_msg
        jsr puts

;
; Prompt for a command and take user input from the terminal.
;
new_prompt:
        lda #$00
        sta CMD_BUFFER_PTR
        ldx #<cmd_prompt
        ldy #>cmd_prompt
        jsr puts

; Loop forever.
get_cmd:
        jsr getch               ; (Possibly) load a single character of terminal input from the buffer.
        bcc get_cmd             ; Carry bit will be set only when valid data is in the Accumulator.
        cmp #$7F                ; The ASCII Delete key ($7F) is labeled Backspace on most PC keyboards.
        bne @check_ctrl         ; When it's not equal to $7F there's nothing special to do.
        lda #$08                ; When it is $7F, replace Delete key ($7F) with Backspace ($08).
@check_ctrl:
        cmp #$20                ; Control characters are anything ordinally lower than ASCII space ($20).
        bcs @printable          ; Space ($20) and above are printable characters.
        jmp @handle_ctrl        ; Below $20 is subject to further processing.
@printable:
        jsr push_cmd_buffer     ; Add the character to the current command buffer.
        bcc @echo               ; If the carry is clear, it was successful. Carry set means buffer full.
        lda #$07                ; Send a bell character as a warning.
@echo:
        jsr putch               ; Echo the character to the terminal.
        jmp get_cmd             ; Repeat.

; Take care of bell, backspace, carriage return. ASCII below $20.
@handle_ctrl:
        cmp #$08                ; Is it backspace?
        bne @check_cr           ; If not, check the next significant CTRL character.
        jsr pop_cmd_buffer      ; Handle the backspace by popping the last character off and discarding it.
        lda #$08                ; Reload the clobbered backspace character.
        jsr putch               ; Echo it to the terminal to back up one character.
        lda #$20                ; Load a space.
        jsr putch               ; Echo it to overwrite the character.
        lda #$08                ; Load another backspace.
        jsr putch               ; Echo it to back up before the space used to overwrite.
        jmp get_cmd             ; When done, go back to looping through input characters.
@check_cr:
        cmp #$0D                ; It it a carriage return?
        bne @ctrl_done          ; If not, there's nothing else to check.
        lda #$00                ; Load a null terminator.
        jsr push_cmd_buffer     ; Put it at the end.
        jsr parse_cmd           ; Otherwise, Carriage Return means the command is ready to be parsed.
        jmp new_prompt          ; After the command is done, the prompt needs to be shown.
@ctrl_done:
        lda #$07                ; Bell as error for anything unhandled.
        jsr putch
        jmp get_cmd


;
; Handle the command buffer LIFO and return either results or an error message.
;

; push_cmd_buffer A
; Append a character to the end.
;   Parameters: A - character to be appended.
;   Returns: Carry clear if success.
;   Registers clobbered: X
push_cmd_buffer:
        ldx CMD_BUFFER_PTR
        cpx #CMD_MAX_LEN        ; If the pointer is greater than the maximum available length:
        bcs @push_done          ; The buffer is full, so keep Carry set as an error indicator and skip the rest.
        sta CMD_BUFFER,X        ; Otherwise, store the character in the buffer.
        inc CMD_BUFFER_PTR      ; And bump the pointer to the next position.
@push_done:
        rts

; pop_cmd_buffer
; Retrieve last value in buffer and return in A if successful.
;   Parameters: none.
;   Returns: Carry clear if success.
;   Registers clobbered: X
pop_cmd_buffer:
        ldx CMD_BUFFER_PTR
        beq @pop_done           ; If the pointer is zero, there's nothing to pop, so skip the rest.
        dex                     ; Otherwise, decrement the pointer.
        lda CMD_BUFFER,X        ; Load the value into the accumulator.
        stx CMD_BUFFER_PTR      ; Update the pointer.
@pop_done:
        rts

parse_cmd:
        nop                     ; TODO
        ldx #<cr_lf
        ldy #>cr_lf
        jsr puts
        rts

;
; Utility subroutines for input and output.
;

; putch A
; Send a single character to the 6551 ACIA.
;   Parameters: A = character to be sent.
;   Returns: nothing.
;   Registers clobbered: none.
putch:
        pha                     ; Save the character while ACIA TX status is checked.
@putch_wait:
        lda ACIA_STATUS
        and #ACIA_TDRE          ; Buffer empty and ready to transmit?
        beq @putch_wait
        pla                     ; Retrieve the character.
        sta ACIA_DATA           ; and send it.
        rts

; puts X, Y
; Output a null-terminated string (up to 255 characters) passing memory location in registers.
;   Parameters: X = string address low. Y = string address high.
;   Returns: nothing.
;   Registers clobbered: A, X, Y.
puts:
        stx PUTS_PTR
        sty PUTS_PTR+1
        ldy #$00                ; Used to iterate over the characters.
@nextch:
        lda (PUTS_PTR),Y        ; Check for null terminator.
        beq @puts_end
@tx_wait:
        lda ACIA_STATUS
        and #ACIA_TDRE          ; Buffer empty and ready to transmit?
        beq @tx_wait
        lda (PUTS_PTR),Y
        sta ACIA_DATA
        iny
        bne @nextch
@puts_end:
        rts

; getch
; Non-blocking load of a single byte from the input buffer. Set carry if data was found.
;   Parameters: none.
;   Returns: Carry set if data. Data byte in Accumulator.
;   Registers clobbered: A, X.
getch:
        ldx ACIA_FIFO_HEAD      ; This is the next byte's index.
        cpx ACIA_FIFO_TAIL      ; Is the FIFO empty?
        beq @empty              ;     If so, skip the rest.
        lda ACIA_FIFO,X         ; Load the byte.
        inc ACIA_FIFO_HEAD      ; Move the buffer pointer up.
        sec                     ; Set carry bit to indicate data is available.
        rts
@empty:
        clc                     ; Clear carry bit to signal no data available.
        rts


;
; Interrupt Service Routine (ISR) to handle hardware interrupts on the CPU's /IRQ line.
;
isr:
        pha                     ; Save registers to avoid trashing whatever process got interrupted.
        txa
        pha
        tya
        pha

; Check 6522 for timer 1 interrupt and update jiffies counter.
        bit VIA_IFR
        bvc @timer1_done
        lda #$40
        sta VIA_IFR
        inc JIFFIES
        bne @timer1_done
        inc JIFFIES + 1
        bne @timer1_done
        inc JIFFIES + 2
        bne @timer1_done
        inc JIFFIES + 3
@timer1_done:

; Check 6551 for input and push to a First In, First Out (FIFO) buffer.

        bit ACIA_STATUS         ; Test bits in ACIA_STATUS to see if new data is available.
        bpl @acia_done          ; Bit 7 clear means no new data, so skip handling the ACIA.
        lda ACIA_DATA           ; Get the data byte.
        ldx ACIA_FIFO_TAIL      ; First, test for possible FIFO wrap around:
        inx                     ; Test the next (HEAD+1) index.
        cpx ACIA_FIFO_HEAD      ; Will head and tail pointers be the same?
        beq @acia_done          ;     If so, skip writing to avoid overflow.
        ldx ACIA_FIFO_TAIL      ; Reload the index with the original position.
        sta ACIA_FIFO,X         ; Write to the head of the FIFO. 
        inc ACIA_FIFO_TAIL      ; Increment pointer to be ready for the next incoming byte.
@acia_done:

; Check save status register for a possible BRK interrupt.

        tsx
        lda $0104,x             ; Saved status register is 3 bytes deeper, because we saved A, X, Y registers.
        and #$10                ; BRK flag is at bit 4 of the saved status register.
        beq @brk_done           ; If it's clear, there was no BRK encountered.
        nop                     ; TODO: Check byte after BRK and execute subroutines from a jump vector table.
        jmp ($FFFE)             ; Restart the system like it just powered on.
@brk_done:

        pla                     ; Restore saved registers before exiting.
        tay
        pla
        tax
        pla
        rti


;
; Handle non-maskable interrupts.
;
nmi:    jmp     nmi


;
; Strings
;
ready_msg:
        .byte "System Ready."
cr_lf:
        .byte $0D, $0A, $00
cmd_prompt:
        .byte "* ", $00         ; Default prompt for command entry.


;
; Pointers for software routines that execute in response to hardware inputs.
;
        .segment "VECTORS"      ; Place 6502 pointers at the top of the address range.
        .word   nmi             ; NMI
        .word   reset           ; RESET
        .word   isr             ; Hardware IRQ / software BRK
