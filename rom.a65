;
; ROM demo with a 6551 ACIA mapped to $8800
;

        .setcpu "65C02"         ; This makes more instructions available.

        .segment "SYSTEM"

;
; 6551 Asynchronous Communications Interface Adapter (ACIA) hardware.
; https://6502.org/documents/datasheets/mos/mos_6551_acia.pdf
;
ACIA_BASE   = $8800             ; Two register select pins are memory mapped from here, giving four possible addresses.
ACIA_DATA   = ACIA_BASE         ; RS1 = 0, RS0 = 0
ACIA_STATUS = ACIA_BASE + 1     ; RS1 = 0, RS0 = 1
ACIA_CMD    = ACIA_BASE + 2     ; RS1 = 1, RS0 = 0
ACIA_CTRL   = ACIA_BASE + 3     ; RS1 = 1, RS0 = 1

ACIA_TDRE   = $10               ; Transmit Data Register Empty (TDRE) bit mask
ACIA_RDRF   = $80               ; Receive Data Register Full (RDRF) bit mask


;
; Zero page locations.
;
PUTS_PTR = $0000                ; 2-byte location of the null-terminated string to be transmitted by the puts subroutine.
ACIA_FIFO_HEAD = $0002          ; 1-byte index of next buffer location to read. Head of ACIA FIFO.
ACIA_FIFO_TAIL = $0003          ; 1-byte index of next buffer location to write. Tail of ACIA FIFO.


;
; Input ring buffer.
;
ACIA_FIFO = $200                ; Raw bytes received from the 6551 ACIA (up to 255 bytes.)


;
; Code to be executed at power-up or hardware reset. Responsible for getting the processor to a usable state.
;
reset:
        sei                     ; Don't want to be disturbed while all this is set up.
        cld                     ; Ensure binary, not binary coded decimal (BCD).
        ldx     #$FF            ; $FF represents the top of the stack.
        txs                     ; Transfer the value to the stack pointer.

        lda #$00                ; Head and tail are initially the same to indicate the input buffer is empty.
        sta ACIA_FIFO_HEAD
        sta ACIA_FIFO_TAIL

        lda #$00
        sta ACIA_STATUS         ; Software reset of 6551 by writing to device's status register.
        lda #$09                ; Configure no parity, no echo, RX interrupt, but no TX interrupt.
        sta ACIA_CMD
        lda #$1E                ; Configure 9600 baud, 8 data bits, 1 stop bit.
        sta ACIA_CTRL

        cli                     ; Allow interrupts again.

        ldx #<ready_msg         ; Output a message to tell the user the system is ready for input.
        ldy #>ready_msg
        jsr puts

;
; Command processing loop: Show prompt. Get input. Execute command. Repeat.
;
        ldx #<cmd_prompt
        ldy #>cmd_prompt
        jsr puts

loop:
        jsr getch               ; (Possibly) load a single character of terminal input from the buffer.
        bcc loop                ; Carry bit will be set by getch when valid data is in the Accumulator.
        cmp #$20                ; Check for control characters (anything ordinally lower than ASCII space.)
        bcs @printable          ; Skip control processing if ASCII space or higher.
        cmp #$0D                ; Check for carriage return (Enter key.)
        bne @not_cr
        ldx #<cr_lf             ; Send a carriage return, line feed combination to move the cursor down.
        ldy #>cr_lf
        jsr puts
        nop                     ; Processing of the command would go here.
        ldx #<cmd_prompt        ; Display a prompt for the next command.
        ldy #>cmd_prompt
        jsr puts
@printable:
        jsr putch               ; Any non-control characters are echoed to the user's terminal.
@not_cr:
        jmp loop                ; Repeat.

;
; Utility subroutines for input and output.
;

; putch A
; Send a single character to the 6551 ACIA.
;   Parameters: A = character to be sent.
;   Returns: nothing.
;   Registers clobbered: none.
putch:
        pha                     ; Save the character while ACIA TX status is checked.
@putch_wait:
        lda ACIA_STATUS
        and #ACIA_TDRE          ; Buffer empty and ready to transmit?
        beq @putch_wait
        pla                     ; Retrieve the character.
        sta ACIA_DATA           ; and send it.
        rts

; puts X, Y
; Output a null-terminated string (up to 255 characters) passing memory location in registers.
;   Parameters: X = string address low. Y = string address high.
;   Returns: nothing.
;   Registers clobbered: A, X, Y.
puts:
        stx PUTS_PTR
        sty PUTS_PTR+1
        ldy #$00                ; Used to iterate over the characters.
@nextch:
        lda (PUTS_PTR),Y        ; Check for null terminator.
        beq @puts_end
@tx_wait:
        lda ACIA_STATUS
        and #ACIA_TDRE          ; Buffer empty and ready to transmit?
        beq @tx_wait
        lda (PUTS_PTR),Y
        sta ACIA_DATA
        iny
        bne @nextch
@puts_end:
        rts

; getch
; Non-blocking load of a single byte from the input buffer. Set carry if data was found.
;   Parameters: none.
;   Returns: Carry set if data. Data byte in Accumulator.
;   Registers clobbered: A, X.
getch:
        ldx ACIA_FIFO_HEAD      ; This is the next byte's index.
        cpx ACIA_FIFO_TAIL      ; Is the FIFO empty?
        beq @empty              ;     If so, skip the rest.
        lda ACIA_FIFO,X         ; Load the byte.
        inc ACIA_FIFO_HEAD      ; Move the buffer pointer up.
        sec                     ; Set carry bit to indicate data is available.
        rts
@empty:
        clc                     ; Clear carry bit to signal no data available.
        rts


;
; Interrupt Service Routine (ISR) to handle hardware interrupts on the CPU's /IRQ line.
;
isr:
        pha                     ; Save registers to avoid trashing whatever process got interrupted.
        txa
        pha
        tya
        pha

; Check 6551 for input and push to a First In, First Out (FIFO) buffer.

        bit ACIA_STATUS         ; Test bits in ACIA_STATUS to see if new data is available.
        bpl @acia_done          ; Bit 7 clear means no new data, so skip handling the ACIA.
        lda ACIA_DATA           ; Get the data byte.
        ldx ACIA_FIFO_TAIL      ; First, test for possible FIFO wrap around:
        inx                     ; Test the next (HEAD+1) index.
        cpx ACIA_FIFO_HEAD      ; Will head and tail pointers be the same?
        beq @acia_done          ;     If so, skip writing to avoid overflow.
        ldx ACIA_FIFO_TAIL      ; Reload the index with the original position.
        sta ACIA_FIFO,X         ; Write to the head of the FIFO. 
        inc ACIA_FIFO_TAIL      ; Increment pointer to be ready for the next incoming byte.

@acia_done:
        pla                     ; Restore saved registers before exiting.
        tay
        pla
        tax
        pla
        rti


;
; Handle non-maskable interrupts.
;
nmi:    jmp     nmi


;
; Strings
;
cr_lf:
        .byte $0D, $0A, $00
ready_msg:
        .byte "System Ready.", $0D, $0A, $00
cmd_prompt:
        .byte "* ", $00         ; Default prompt for command entry.


;
; Pointers for software routines that execute in response to hardware inputs.
;
        .segment "VECTORS"      ; Place 6502 pointers at the top of the address range.
        .word   nmi             ; NMI
        .word   reset           ; RESET
        .word   isr             ; Hardware IRQ / software BRK
