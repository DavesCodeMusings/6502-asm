;
; ROM demo with a 6551 ACIA mapped to $8800
;

        .setcpu "65C02"         ; This makes more instructions available.

        .segment "SYSTEM"

;
; 6551 Asynchronous Communications Interface Adapter (ACIA) hardware
;
ACIA_BASE   = $8800
ACIA_DATA   = ACIA_BASE
ACIA_STATUS = ACIA_BASE + 1
ACIA_CMD    = ACIA_BASE + 2
ACIA_CTRL   = ACIA_BASE + 3

ACIA_TDRE   = $10               ; Transmit Data Register Empty (TDRE) bit flag


;
; Zero page locations
;
PUTS_PTR = $0000                ; 2-byte location of the null-terminated string to be transmitted by the puts subroutine. 


;
; Code executed at power-up or hardware reset.
;
reset:
        sei
        cld                     ; Ensure binary, not binary coded decimal (BCD).
        ldx     #$FF            ; $FF represents the top of the stack.
        txs                     ; Transfer it to the stack pointer.
        cli                     ; Allow interrupts once again.

ACIA_reset:
        lda #$0B                ; Configure no parity, no echo, and polling mode (no TX/RX interrupts)
        sta ACIA_CMD
        lda #$1E                ; Configure 9600 baud, 8 data bits, 1 stop bit.
        sta ACIA_CTRL

show_ready:
        ldx #<ready_msg
        ldy #>ready_msg
        jsr puts

;
; Command processing loop.
;
show_prompt:
        ldx #<cmd_prompt
        ldy #>cmd_prompt
        jsr puts

loop:
        jmp     loop            ; Do nothing for now

;
; Subroutines
;

; Output a single character.
; Parameters:
;   A = character to be sent.
putch:
        pha                     ; Save the character until ACIA TX status is checked.
@putch_wait:
        lda ACIA_STATUS
        and #ACIA_TDRE          ; Buffer empty and ready to transmit?
        beq @putch_wait
        pla                     ; Retrieve the character
        sta ACIA_DATA           ; and send it.
        rts


; Output a null-terminated string (up to 255 characters) using memory location in registers.
; Parameters:
;   X = string address low
;   Y = string address high
; Clobbers:
;   A, X, Y, Zero page PUTS_PTR
puts:
        stx PUTS_PTR
        sty PUTS_PTR+1
        ldy #$00                ; Used to iterate over the characters.
@nextch:
        lda (PUTS_PTR),Y        ; Check for null terminator.
        beq @puts_end
@tx_wait:
        lda ACIA_STATUS
        and #ACIA_TDRE          ; Buffer empty and ready to transmit?
        beq @tx_wait
        lda (PUTS_PTR),Y
        sta ACIA_DATA
        iny
        bne @nextch
@puts_end:
        rts


nmi:    jmp     nmi


irq_brk: 
        jmp     irq_brk        ;


ready_msg:
        .byte "System Ready.", $0D, $0A, $00
cmd_prompt:
        .byte "* ", $00         ; Default prompt for command entry.


        .segment "VECTORS"      ; 6502 pointers at the top of the address range.
        .word   nmi             ; NMI
        .word   reset           ; RESET
        .word   irq_brk         ; IRQ/BRK
