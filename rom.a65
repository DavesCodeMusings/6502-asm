;
; ROM demo with a 6551 ACIA mapped to $8800
;

        .setcpu "65C02"         ; This makes more instructions available.

        .segment "SYSTEM"

ACIA_BASE   = $8800
ACIA_DATA   = ACIA_BASE
ACIA_STATUS = ACIA_BASE + 1
ACIA_CMD    = ACIA_BASE + 2
ACIA_CTRL   = ACIA_BASE + 3

ACIA_TDRE   = $10             ; Transmit Data Register Empty (TDRE) bit flag


PROMPT      = '*'


reset:
        sei                     ; This code is for both power-up and hard reset.
        cld                     ; Ensure binary, not binary coded decimal (BCD).
        ldx     #$FF            ; $FF represents the top of the stack.
        txs                     ; Transfer it to the stack pointer.
        cli                     ; Allow interrupts once again.

ACIA_reset:
        lda #$0B                ; no parity, no echo, polling (no TX/RX interrupts)
        sta ACIA_CMD
        lda #$1E                ; 9600 baud, 8 data bits, 1 stop bit
        sta ACIA_CTRL

show_prompt:
@wait:  lda ACIA_STATUS
        and #ACIA_TDRE          ; Buffer empty and ready to transmit?
        beq @wait
        lda #PROMPT
        sta ACIA_DATA



loop:   jmp     loop            ; Do nothing for now


nmi:    jmp     nmi


irq_brk: 
        jmp     irq_brk         ;

        .segment "VECTORS"      ; 6502 pointers at the top of the address range.
        .word   nmi             ; NMI
        .word   reset           ; RESET
        .word   irq_brk         ; IRQ/BRK
